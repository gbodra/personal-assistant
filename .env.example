# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Local: http://localhost:3000 — Render: https://<service>.onrender.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional legacy alias (used if publishable key is empty)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never NEXT_PUBLIC_*; never commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for Focus board Realtime (Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional: NL rule compilation via OpenAI (falls back to heuristic parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Signup is disabled when NODE_ENV=production (Render).
# Create accounts only via `pnpm dev` → /signup against the same Supabase project.
